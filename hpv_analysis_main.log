. *******************************************************
. * PHÂN TÍCH BẤT BÌNH ĐẲNG KINH TẾ-XÃ HỘI TRONG NHẬN THỨC
. * VÀ TIÊM CHỦNG HPV Ở PHỤ NỮ VIỆT NAM 15-29 TUỔI
. * Nguồn: MICS6 Việt Nam (2020-2021)
. *
. * Biến kết quả (Outcomes):
. *   1. ccp5_bin – Đã nghe về vắc-xin HPV (nhận thức)
. *   2. ccp6_bin – Đã tiêm vắc-xin HPV (tiêm chủng)
. *   3. gap      – Biết nhưng chưa tiêm (khoảng cách)
. *
. * Phương pháp:
. *   - Mô tả có trọng số (survey-weighted descriptive)
. *   - Phân tích hai biến (bivariate chi-squared)
. *   - Chỉ số tập trung (Concentration Index)
. *   - Hồi quy Poisson có trọng số (PR + 95%CI)
. *   - Phân rã Erreygers (decomposition)
. *
. * Đối tượng: Phụ nữ Việt Nam 15-29 tuổi (MICS6)
. * Cập nhật: 2026-04-22
. *******************************************************
. 
. version 17

. clear all

. set more off

. set linesize 255

. set type double

. macro drop _all

. 
. *───────────────────────────────────────────────────────
. * 1. PROJECT PATHS
. *───────────────────────────────────────────────────────
. local root "`c(pwd)'"

. local proj "`root'/HPV thesis"

. local data_dir "`proj'/Dataset"

. local out_dir  "`proj'/Output"

. local tab_dir  "`out_dir'/tables"

. local fig_dir  "`out_dir'/figures"

. local log_dir  "`out_dir'/logs"

. local int_dir  "`out_dir'/intermediate"

. 
. * Create output directories if they do not exist.
. foreach d in "`out_dir'" "`tab_dir'" "`fig_dir'" "`log_dir'" "`int_dir'" {
  2.     capture mkdir `"`d'"'
  3. }

. 
. capture log close _all

. log using "`log_dir'/hpv_analysis_master.log", replace text name(master)
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
      name:  master
       log:  C:\Users\phamh\OneDrive\Documents\Thesis_2026/HPV thesis/Output/logs/hpv_analysis_master.log
  log type:  text
 opened on:  22 Apr 2026, 18:01:18

. 
. di as txt "Project root : `root'"
Project root : C:\Users\phamh\OneDrive\Documents\Thesis_2026

. di as txt "Start time   : `c(current_date)' `c(current_time)'"
Start time   : 22 Apr 2026 18:01:18

. 
. *───────────────────────────────────────────────────────
. * 2. LOAD DATA
. *───────────────────────────────────────────────────────
. * Dữ liệu MICS6 Việt Nam (international format).
. local src_main "`data_dir'/data_raw_mics6_inter_format.dta"

. 
. if fileexists("`src_main'") {
.     use "`src_main'", clear
.     di as result "Đã tải: `src_main'"
Đã tải: C:\Users\phamh\OneDrive\Documents\Thesis_2026/HPV thesis/Dataset/data_raw_mics6_inter_format.dta
. }

. else {
.     di as error "Không tìm thấy dữ liệu nguồn trong: `data_dir'"
.     error 601
. }

. 
. * Kiểm tra các biến bắt buộc phải có trong dữ liệu.
. local required "CCP5 CCP6 WAGE MSTATUS welevel insurance ethnicity2"

. local required "`required' wscore windex5 HH1 HH6 wmweight"

. local required "`required' MT1 MT2 MT3 MT5 MT10 MT12"

. local required "`required' DV1A DV1B DV1C DV1D DV1E SB1 PSU stratum"

. foreach v of local required {
  2.     capture confirm variable `v'
  3.     if _rc {
  4.         di as error "Missing required variable: `v'"
  5.         error 111
  6.     }
  7. }

. 
. *───────────────────────────────────────────────────────
. * 3. MẪU PHÂN TÍCH
. * MICS6 phỏng vấn phụ nữ 15-49 tuổi (WAGE 1-7).
. * Phân tích giới hạn nhóm 15-29 tuổi (WAGE 1-3)
. * để đánh giá bất bình đẳng trong nhận thức và
. * tiêm chủng HPV ở phụ nữ trẻ Việt Nam.
. *───────────────────────────────────────────────────────
. keep if inrange(WAGE, 1, 3)
(7,192 observations deleted)

. drop if missing(wmweight, PSU, stratum)
(0 observations deleted)

. count
  4,102

. local N_analytic = r(N)

. di as result "Mẫu phân tích (phụ nữ 15-29): `N_analytic'"
Mẫu phân tích (phụ nữ 15-29): 4102

. 
. * Đổi tên biến cho rõ ràng.
. rename wscore  ses    // Điểm kinh tế-xã hội (wealth score)

. rename windex5 ses5   // Nhóm ngũ phân vị giàu nghèo

. rename HH1     ea     // Đơn vị liệt kê (enumeration area)

. rename HH6     area   // Thành thị / Nông thôn

. 
. *───────────────────────────────────────────────────────
. * 4. LÀM SẠCH VÀ MÃ HÓA LẠI BIẾN SỐ
. *───────────────────────────────────────────────────────
. 
. * 4a. Clean non-informative / out-of-range codes to missing.
. replace MSTATUS    = . if !inlist(MSTATUS, 1, 2, 3)
(1 real change made, 1 to missing)

. replace insurance  = . if !inlist(insurance, 1, 2)
(1 real change made, 1 to missing)

. replace ethnicity2 = . if !inlist(ethnicity2, 1, 2)
(0 real changes made)

. replace welevel    = . if !inlist(welevel, 0, 1, 2, 3, 4, 5)
(0 real changes made)

. replace ses5       = . if !inrange(ses5, 1, 5)
(0 real changes made)

. 
. * 4b. Value labels.
. label define yn          0 "No" 1 "Yes", replace

. label define area_lab    1 "Urban" 2 "Rural", replace

. label define wage_lab    1 "15-19" 2 "20-24" 3 "25-29", replace

. label define mstatus_lab 1 "Currently married/union" ///
>                          2 "Formerly married/union"  ///
>                          3 "Never married/union", replace

. label define edu_lab     1 "Primary or less" ///
>                          2 "Lower secondary" ///
>                          3 "Upper secondary+", replace

. label define ses5_lab    1 "Q1 poorest" 2 "Q2" 3 "Q3" ///
>                          4 "Q4" 5 "Q5 richest", replace

. 
. label values WAGE    wage_lab

. label values area    area_lab

. label values MSTATUS mstatus_lab

. label values ses5    ses5_lab

. 
. *───────────────────────────────────────────────────────
. * 5. OUTCOME VARIABLES
. *───────────────────────────────────────────────────────
. 
. * 5a. HPV awareness (CCP5: 1=Yes, 2=No).
. gen byte ccp5_bin = .
(4,102 missing values generated)

. replace ccp5_bin = 1 if CCP5 == 1
(2,133 real changes made)

. replace ccp5_bin = 0 if CCP5 == 2
(1,969 real changes made)

. label values ccp5_bin yn

. label variable ccp5_bin "Heard about HPV vaccination"

. 
. * 5b. HPV vaccination (CCP6: 1=Yes, 2=No, 8=DK).
. *     MICS skip: if CCP5=2 (not aware), CCP6 is skipped → code as 0.
. gen byte ccp6_bin = .
(4,102 missing values generated)

. replace ccp6_bin = 1 if CCP6 == 1
(220 real changes made)

. replace ccp6_bin = 0 if inlist(CCP6, 2, 8)
(1,913 real changes made)

. replace ccp6_bin = 0 if missing(CCP6) & CCP5 == 2
(1,969 real changes made)

. label values ccp6_bin yn

. label variable ccp6_bin "Received HPV vaccine"

. 
. * 5c. Awareness-vaccination gap (among aware women only).
. gen byte gap = .
(4,102 missing values generated)

. replace gap = 1 if ccp5_bin == 1 & ccp6_bin == 0
(1,913 real changes made)

. replace gap = 0 if ccp5_bin == 1 & ccp6_bin == 1
(220 real changes made)

. label define gap_lab 0 "Aware & vaccinated" 1 "Aware but not vaccinated", replace

. label values gap gap_lab

. label variable gap "Awareness-vaccination gap"

. 
. *───────────────────────────────────────────────────────
. * 6. COVARIATE CONSTRUCTION
. *───────────────────────────────────────────────────────
. 
. * Education: collapse MICS welevel into 3 groups.
. gen byte edu = .
(4,102 missing values generated)

. replace edu = 1 if inlist(welevel, 0, 1)   // Primary or less
(601 real changes made)

. replace edu = 2 if welevel == 2             // Lower secondary
(1,074 real changes made)

. replace edu = 3 if inlist(welevel, 3, 4, 5) // Upper secondary+
(2,427 real changes made)

. label values edu edu_lab

. label variable edu "Education group"

. 
. * Insurance status (1=insured, 2=uninsured → recode to 0/1).
. gen byte insu = .
(4,102 missing values generated)

. replace insu = 1 if insurance == 2
(496 real changes made)

. replace insu = 0 if insurance == 1
(3,605 real changes made)

. label values insu yn

. label variable insu "Uninsured"

. 
. * Rural residence.
. gen byte rural = .
(4,102 missing values generated)

. replace rural = 1 if area == 2
(2,896 real changes made)

. replace rural = 0 if area == 1
(1,206 real changes made)

. label values rural yn

. label variable rural "Rural residence"

. 
. * Ethnic minority (ethnicity2: 1=Kinh/Hoa, 2=minority).
. gen byte minority = .
(4,102 missing values generated)

. replace minority = 1 if ethnicity2 == 2
(1,687 real changes made)

. replace minority = 0 if ethnicity2 == 1
(2,415 real changes made)

. label values minority yn

. label variable minority "Ethnic minority"

. 
. * Mass media exposure (MT1=newspaper, MT2=radio, MT3=TV).
. foreach v in MT1 MT2 MT3 MT5 MT10 MT12 {
  2.     replace `v' = . if !inlist(`v', 0, 1, 2, 3)
  3.     gen byte `v'_use = .
  4.     replace `v'_use = 1 if inrange(`v', 1, 3)
  5.     replace `v'_use = 0 if `v' == 0
  6. }
(2 real changes made, 2 to missing)
(4,102 missing values generated)
(2,344 real changes made)
(1,756 real changes made)
(1 real change made, 1 to missing)
(4,102 missing values generated)
(433 real changes made)
(3,668 real changes made)
(0 real changes made)
(4,102 missing values generated)
(2,909 real changes made)
(1,193 real changes made)
(0 real changes made)
(4,102 missing values generated)
(1,211 real changes made)
(701 real changes made)
(1 real change made, 1 to missing)
(4,102 missing values generated)
(3,232 real changes made)
(38 real changes made)
(1 real change made, 1 to missing)
(4,102 missing values generated)
(3,847 real changes made)
(254 real changes made)

. 
. egen mme_obs = rownonmiss(MT1_use MT2_use MT3_use)

. egen mme_any = rowmax(MT1_use MT2_use MT3_use)

. gen byte mme = .
(4,102 missing values generated)

. replace mme = mme_any if mme_obs > 0
(4,102 real changes made)

. drop mme_obs mme_any

. label values mme yn

. label variable mme "Any mass media exposure"

. 
. * ICT exposure (MT5=computer, MT10=internet, MT12=mobile).
. egen ict_obs = rownonmiss(MT5_use MT10_use MT12_use)

. egen ict_any = rowmax(MT5_use MT10_use MT12_use)

. gen byte ict = .
(4,102 missing values generated)

. replace ict = ict_any if ict_obs > 0
(4,102 real changes made)

. drop ict_obs ict_any

. label values ict yn

. label variable ict "Any ICT exposure"

. 
. * Decision autonomy (DV1A-E: 1=alone, 2=jointly/other).
. * High autonomy = all decisions made alone or jointly.
. foreach v in DV1A DV1B DV1C DV1D DV1E {
  2.     replace `v' = . if !inlist(`v', 1, 2)
  3. }
(95 real changes made, 95 to missing)
(115 real changes made, 115 to missing)
(111 real changes made, 111 to missing)
(185 real changes made, 185 to missing)
(76 real changes made, 76 to missing)

. gen byte dvindex = .
(4,102 missing values generated)

. replace dvindex = 1 if DV1A==2 & DV1B==2 & DV1C==2 & DV1D==2 & DV1E==2
(3,367 real changes made)

. replace dvindex = 0 if DV1A==1 | DV1B==1 | DV1C==1 | DV1D==1 | DV1E==1
(534 real changes made)

. label values dvindex yn

. label variable dvindex "High decision autonomy"

. 
. * Sexual behavior (SB1: age at first intercourse, 0=never).
. replace SB1 = . if inlist(SB1, 8, 98, 99)
(1 real change made, 1 to missing)

. gen byte sb1n = .
(4,102 missing values generated)

. replace sb1n = 0 if SB1 == 0
(1,632 real changes made)

. replace sb1n = 1 if inrange(SB1, 1, 95)
(2,469 real changes made)

. label values sb1n yn

. label variable sb1n "Ever had sexual intercourse"

. 
. *───────────────────────────────────────────────────────
. * 7. CHECK ICT IMBALANCE
. *    If weighted prevalence >95% or <5%, ICT causes
. *    quasi-separation in Poisson → exclude from models.
. *───────────────────────────────────────────────────────
. quietly summarize ict [aw=wmweight]

. local ict_mean = r(mean)

. local include_ict = 1

. if `ict_mean' > 0.95 | `ict_mean' < 0.05 {
.     local include_ict = 0
.     di as txt "NOTE: ICT weighted prevalence = " %5.3f `ict_mean' ///
>         " → excluded from multivariable models (quasi-separation risk)."
NOTE: ICT weighted prevalence = 0.979 → excluded from multivariable models (quasi-separation risk).
. }

. 
. * Build model terms conditionally.
. local model_ict ""

. local decomp_ict ""

. if `include_ict' {
.     local model_ict "i.ict"
.     local decomp_ict "ict"
. }

. 
. *───────────────────────────────────────────────────────
. * 8. SURVEY DESIGN
. *───────────────────────────────────────────────────────
. svyset PSU [pweight=wmweight], strata(stratum) vce(linearized) singleunit(centered)

