. 
. *===============================================================
. *  FIGURE 7: CONCENTRATION CURVE
. *  Lorenz-type curve showing inequality in awareness & vaccination
. *===============================================================
. 
. * Generate fractional rank of SES.
. sort ses

. quietly gen rank_ses = .

. quietly summarize wmweight

. quietly gen cumw = sum(wmweight)

. quietly replace rank_ses = (cumw - wmweight/2) / cumw[_N]

. 
. * Compute cumulative share of outcome weighted by rank.
. * Awareness concentration curve.
. quietly gen wa = ccp5_bin * wmweight

. sort rank_ses

. quietly gen cum_wa = sum(wa)

. quietly summarize wa

. quietly gen cc_aware = cum_wa / cum_wa[_N]

. 
. * Vaccination concentration curve.
. quietly gen wv = ccp6_bin * wmweight

. sort rank_ses

. quietly gen cum_wv = sum(wv)

. quietly summarize wv

. quietly gen cc_vacc = cum_wv / cum_wv[_N]

. 
. twoway (line cc_aware rank_ses, sort lcolor(blue) lwidth(medthick)) ///
>        (line cc_vacc rank_ses, sort lcolor(red) lwidth(medthick)) ///
>        (function y=x, range(0 1) lcolor(gray) lpattern(dash)), ///
>     title("Concentration Curves for HPV Awareness and Vaccination", size(medium)) ///
>     subtitle("Women aged 15-29, Vietnam MICS6", size(small)) ///
>     xtitle("Cumulative share of population (poorest to richest)") ///
>     ytitle("Cumulative share of outcome") ///
>     legend(order(1 "Awareness" 2 "Vaccination" 3 "Line of equality") rows(1) size(small)) ///
>     graphregion(color(white)) plotregion(color(white))

. graph export "`fig_dir'/fig7_concentration_curve.png", replace width(2400)
file C:\Users\phamh\OneDrive\Documents\Thesis_2026/HPV thesis/Output/figures/fig7_concentration_curve.png saved as PNG format

. 
. drop wa cum_wa cc_aware wv cum_wv cc_vacc cumw rank_ses

