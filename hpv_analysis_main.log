. foreach y in ccp5_bin ccp6_bin gap {
  2.     capture noisily conindex `y', rankvar(ses) truezero limits(0 1) svy
  3.     if _rc == 0 {
  4.         scalar ci_v  = r(CI)
  5.         scalar se_v  = r(CIse)
  6.         scalar z975  = invnormal(0.975)
  7.         scalar lci_v = ci_v - z975 * se_v
  8.         scalar uci_v = ci_v + z975 * se_v
  9.         post `ci_post' ("`y'") (r(N)) (ci_v) (se_v) (lci_v) (uci_v)
 10.     }
