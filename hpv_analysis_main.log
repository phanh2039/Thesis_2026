. tempname dp

. postfile `dp' str12 outcome str20 variable ///
>     double(dydx mean_x ci_x elasticity contribution percentage) ///
>     using "`tab_dir'/table6_decomposition.dta", replace

. 
. foreach y in ccp5_bin ccp6_bin gap {
  2. 
.     di as txt _newline "============================================"
  3.     di as txt "Erreygers decomposition for: `y'"
  4.     di as txt "============================================"
  5. 
.     capture noisily conindex `y', rankvar(ses) bounded limits(0 1) erreygers svy
  6.     if _rc != 0 {
  7.         di as error "conindex failed for `y' — skipping."
  8.         continue
  9.     }
 10.     scalar CI_total = r(CI)
 11.     di as txt "Erreygers CI = " %8.5f CI_total
 12. 
.     * Fit probit model via GLM, then compute average marginal effects.
.     quietly svy: glm `y' `X', family(binomial) link(probit)
 13.     quietly margins, dydx(*) post
 14.     matrix b_marg = e(b)
 15. 
.     local nvars : word count `X'
 16.     di as txt "Decomposing `nvars' variables..."
 17. 
.     foreach x of local X {
 18.         * Find column in margins matrix.
.         local col = colnumb(b_marg, "`x'")
 19.         if `col' >= . {
 20.             di as txt "  `x': not found in margins — skipped"
 21.             continue
 22.         }
 23.         scalar b_x = b_marg[1, `col']
 24. 
.         * CI of the covariate itself.
.         quietly conindex `x', rankvar(ses) bounded limits(0 1) erreygers svy
 25.         scalar CI_x = r(CI)
 26. 
.         * Weighted mean of covariate.
.         quietly summarize `x' [aw=wmweight]
 27.         scalar mean_x = r(mean)
 28. 
.         * Erreygers elasticity & contribution.
.         scalar elas    = 4 * (b_x * mean_x)
 29.         scalar contrib = elas * CI_x
 30.         scalar pct     = .
 31.         if CI_total != 0  scalar pct = (contrib / CI_total) * 100
 32. 
.         di as txt "  `x': dydx=" %7.4f b_x ///
>             " mean=" %6.4f mean_x ///
>             " CI_x=" %8.5f CI_x ///
>             " contrib=" %8.5f contrib ///
>             " (" %5.1f pct "%)"
 33. 
.         post `dp' ("`y'") ("`x'") (b_x) (mean_x) (CI_x) (elas) (contrib) (pct)
 34.     }
 35. }

