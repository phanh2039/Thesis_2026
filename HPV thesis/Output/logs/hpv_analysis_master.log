. * 7. DESCRIPTIVE TABLE WITH SURVEY-WEIGHTED 95% CI
. *******************************************************************************
. 
. capture postclose t1

. tempname t1

. postfile `t1' str40 variable str60 category double(unweighted_n pct lci uci) ///
>     using "`tab_dir'/table1_descriptive.dta", replace

. 
. local profile_vars "WAGE area minority insu MSTATUS edu ses5 ccp5_bin ccp6_bin gap mme ict dvindex sb1n"

. foreach v of local profile_vars {
  2.     local vlabel : variable label `v'
  3.     if "`vlabel'" == "" local vlabel "`v'"
  4.     levelsof `v' if !missing(`v'), local(levels)
  5.     foreach lev of local levels {
  6.         local cat : label (`v') `lev'
  7.         if "`cat'" == "" local cat "`lev'"
  8.         quietly count if `v' == `lev'
  9.         scalar __n = r(N)
 10.         tempvar ind
 11.         gen byte `ind' = (`v' == `lev') if !missing(`v')
 12.         quietly svy: mean `ind'
 13.         matrix __m = r(table)
 14.         scalar __pct = __m[1,1] * 100
 15.         scalar __lci = __m[5,1] * 100
 16.         scalar __uci = __m[6,1] * 100
 17.         post `t1' ("`vlabel'") ("`cat'") (__n) (__pct) (__lci) (__uci)
 18.         drop `ind'
 19.     }
 20. }
