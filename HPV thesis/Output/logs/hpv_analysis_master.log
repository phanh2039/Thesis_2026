. *******************************************************************************
. * 8. BIVARIATE TABLES: SURVEY-WEIGHTED ROW % AND DESIGN-BASED PEARSON TEST
. *******************************************************************************
. 
. local assoc_vars "WAGE area minority insu MSTATUS edu ses5 mme ict dvindex sb1n"

. 
. foreach outcome in ccp5_bin ccp6_bin gap ccp6_aware {
  2.     if "`outcome'" == "ccp5_bin" {
  3.         local outname "awareness"
  4.         local outfile "`tab_dir'/table2_awareness_bivariate"
  5.     }
  6.     else if "`outcome'" == "ccp6_bin" {
  7.         local outname "vaccination"
  8.         local outfile "`tab_dir'/table3_vaccination_bivariate"
  9.     }
 10.     else if "`outcome'" == "ccp6_aware" {
 11.         local outname "vaccination_aware"
 12.         local outfile "`tab_dir'/table7_vaccination_aware_sensitivity"
 13.     }
 14.     else {
 15.         local outname "gap"
 16.         local outfile "`tab_dir'/table3b_gap_bivariate"
 17.     }
 18. 
.     capture postclose tbiv
 19.     tempname tbiv
 20.     postfile `tbiv' str40 variable str60 category str20 outcome ///
>         double(unweighted_n pct lci uci pvalue) using "`outfile'.dta", replace
 21. 
.     capture log close `outname'_biv
 22.     log using "`outfile'.log", replace text name(`outname'_biv)
 23. 
.     foreach v of local assoc_vars {
 24.         local vlabel : variable label `v'
 25.         if "`vlabel'" == "" local vlabel "`v'"
 26. 
.         scalar __p = .
 27.         if inlist("`outcome'", "gap", "ccp6_aware") {
 28.             capture noisily svy, subpop(ccp5_bin): tabulate `v' `outcome', row percent ci pearson format(%5.1f)
 29.         }
 30.         else {
 31.             capture noisily svy: tabulate `v' `outcome', row percent ci pearson format(%5.1f)
 32.         }
 33.         capture scalar __p = e(p_Pear)
 34.         if missing(__p) {
 35.             capture scalar __p = e(p_Penl)
 36.         }
 37. 
.         levelsof `v' if !missing(`v'), local(levels)
 38.         foreach lev of local levels {
 39.             local cat : label (`v') `lev'
 40.             if "`cat'" == "" local cat "`lev'"
 41.             if inlist("`outcome'", "gap", "ccp6_aware") {
 42.                 quietly count if `v' == `lev' & ccp5_bin == 1 & !missing(gap)
 43.                 scalar __n = r(N)
 44.                 tempvar sub
 45.                 gen byte `sub' = (`v' == `lev' & ccp5_bin == 1) if !missing(`v') & !missing(ccp5_bin)
 46.                 replace `sub' = 0 if missing(`sub')
 47.                 quietly svy, subpop(`sub'): proportion `outcome'
 48.             }
 49.             else {
 50.                 quietly count if `v' == `lev' & !missing(`outcome')
 51.                 scalar __n = r(N)
 52.                 tempvar sub
 53.                 gen byte `sub' = (`v' == `lev') if !missing(`v') & !missing(`outcome')
 54.                 replace `sub' = 0 if missing(`sub')
 55.                 quietly svy, subpop(`sub'): proportion `outcome'
 56.             }
 57.             matrix __m = r(table)
 58.             scalar __pct = __m[1,2] * 100
 59.             scalar __lci = __m[5,2] * 100
 60.             scalar __uci = __m[6,2] * 100
 61.             post `tbiv' ("`vlabel'") ("`cat'") ("`outcome'") (__n) (__pct) (__lci) (__uci) (__p)
 62.             drop `sub'
 63.         }
 64.     }
 65.     log close `outname'_biv
 66. 
.     postclose `tbiv'
 67.     preserve
 68.     use "`outfile'.dta", clear
 69.     format pct lci uci %6.2f
 70.     format pvalue %9.4f
 71.     export delimited using "`outfile'.csv", replace
 72.     restore
 73. }
