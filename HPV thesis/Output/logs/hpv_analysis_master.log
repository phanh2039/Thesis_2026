. *******************************************************************************
. * 10. ADJUSTED POISSON MODELS AND LOGISTIC SENSITIVITY MODELS
. *******************************************************************************
. 
. local X_model "i.rural ib3.WAGE ib1.MSTATUS ib3.edu i.insu i.minority ib5.ses5 i.mme `model_ict' i.dvindex i.sb1n"

. 
. capture postclose modout

. tempname modout

. postfile `modout' str24 model str16 outcome str60 term double(n estimate lci uci pvalue) ///
>     using "`tab_dir'/table5_models.dta", replace

. 
. capture postclose margout

. tempname margout

. postfile `margout' str24 model str16 outcome byte ses5 str20 wealth_quintile ///
>     double(n pct lci uci) using "`tab_dir'/table8_adjusted_predicted_by_wealth.dta", replace

. 
. foreach y in ccp5_bin ccp6_bin gap ccp6_aware {
  2.     if "`y'" == "gap" {
  3.         quietly svy, subpop(ccp5_bin): poisson gap `X_model'
  4.         local modelname "aPR_gap"
  5.     }
  6.     else if "`y'" == "ccp6_aware" {
  7.         quietly svy, subpop(ccp5_bin): poisson ccp6_aware `X_model'
  8.         local modelname "aPR_vaccination_aware"
  9.     }
 10.     else {
 11.         quietly svy: poisson `y' `X_model'
 12.         if "`y'" == "ccp5_bin" local modelname "aPR_awareness"
 13.         if "`y'" == "ccp6_bin" local modelname "aPR_vaccination"
 14.     }
 15. 
.     local df = e(df_r)
 16.     local nobs = e(N)
 17. 
.     matrix __b = e(b)
 18.     local terms : colnames __b
 19.     foreach term of local terms {
 20.         if "`term'" == "_cons" continue
 21.         if strpos("`term'", "b.") continue
 22.         if strpos("`term'", "o.") continue
 23.         local nice "`term'"
 24.         if "`term'" == "1.rural"    local nice "Rural (ref: urban)"
 25.         if "`term'" == "1.WAGE"     local nice "Age 15-19 (ref: 25-29)"
 26.         if "`term'" == "2.WAGE"     local nice "Age 20-24 (ref: 25-29)"
 27.         if "`term'" == "2.MSTATUS"  local nice "Formerly married/union (ref: current)"
 28.         if "`term'" == "3.MSTATUS"  local nice "Never married/union (ref: current)"
 29.         if "`term'" == "1.edu"      local nice "Primary or less (ref: upper secondary+)"
 30.         if "`term'" == "2.edu"      local nice "Lower secondary (ref: upper secondary+)"
 31.         if "`term'" == "1.insu"     local nice "Uninsured (ref: insured)"
 32.         if "`term'" == "1.minority" local nice "Ethnic minority (ref: Kinh/Hoa)"
 33.         if "`term'" == "1.ses5"     local nice "Q1 poorest (ref: Q5 richest)"
 34.         if "`term'" == "2.ses5"     local nice "Q2 (ref: Q5 richest)"
 35.         if "`term'" == "3.ses5"     local nice "Q3 (ref: Q5 richest)"
 36.         if "`term'" == "4.ses5"     local nice "Q4 (ref: Q5 richest)"
 37.         if "`term'" == "1.mme"      local nice "Mass media exposure (ref: no)"
 38.         if "`term'" == "1.ict"      local nice "ICT exposure (ref: no)"
 39.         if "`term'" == "1.dvindex"  local nice "Rejects all wife-beating justifications (ref: no)"
 40.         if "`term'" == "1.sb1n"     local nice "Ever had sexual intercourse (ref: no)"
 41.         scalar __est = exp(_b[`term'])
 42.         scalar __se  = _se[`term']
 43.         scalar __tcrit = invttail(`df', 0.025)
 44.         scalar __l = exp(_b[`term'] - __tcrit * __se)
 45.         scalar __u = exp(_b[`term'] + __tcrit * __se)
 46.         scalar __p = 2 * ttail(`df', abs(_b[`term'] / __se))
 47.         post `modout' ("`modelname'") ("`y'") ("`nice'") (`nobs') (__est) (__l) (__u) (__p)
 48.     }
 49. }

. 
. foreach y in ccp5_bin ccp6_bin gap ccp6_aware {
  2.     if "`y'" == "gap" {
  3.         quietly svy, subpop(ccp5_bin): logistic gap `X_model'
  4.         local modelname "OR_gap"
  5.         local predname "pred_gap"
  6.     }
  7.     else if "`y'" == "ccp6_aware" {
  8.         quietly svy, subpop(ccp5_bin): logistic ccp6_aware `X_model'
  9.         local modelname "OR_vaccination_aware"
 10.         local predname "pred_vaccination_aware"
 11.     }
 12.     else {
 13.         quietly svy: logistic `y' `X_model'
 14.         if "`y'" == "ccp5_bin" local modelname "OR_awareness"
 15.         if "`y'" == "ccp6_bin" local modelname "OR_vaccination"
 16.         if "`y'" == "ccp5_bin" local predname "pred_awareness"
 17.         if "`y'" == "ccp6_bin" local predname "pred_vaccination"
 18.     }
 19. 
.     local df = e(df_r)
 20.     local nobs = e(N)
 21. 
.     quietly margins ses5
 22.     matrix __marg = r(table)
 23.     forvalues q = 1/5 {
 24.         local qlab : label ses5_lab `q'
 25.         scalar __mpct = __marg[1,`q'] * 100
 26.         scalar __mlci = __marg[5,`q'] * 100
 27.         scalar __muci = __marg[6,`q'] * 100
 28.         post `margout' ("`predname'") ("`y'") (`q') ("`qlab'") (`nobs') (__mpct) (__mlci) (__muci)
 29.     }
 30. 
.     matrix __b = e(b)
 31.     local terms : colnames __b
 32.     foreach term of local terms {
 33.         if "`term'" == "_cons" continue
 34.         if strpos("`term'", "b.") continue
 35.         if strpos("`term'", "o.") continue
 36.         local nice "`term'"
 37.         if "`term'" == "1.rural"    local nice "Rural (ref: urban)"
 38.         if "`term'" == "1.WAGE"     local nice "Age 15-19 (ref: 25-29)"
 39.         if "`term'" == "2.WAGE"     local nice "Age 20-24 (ref: 25-29)"
 40.         if "`term'" == "2.MSTATUS"  local nice "Formerly married/union (ref: current)"
 41.         if "`term'" == "3.MSTATUS"  local nice "Never married/union (ref: current)"
 42.         if "`term'" == "1.edu"      local nice "Primary or less (ref: upper secondary+)"
 43.         if "`term'" == "2.edu"      local nice "Lower secondary (ref: upper secondary+)"
 44.         if "`term'" == "1.insu"     local nice "Uninsured (ref: insured)"
 45.         if "`term'" == "1.minority" local nice "Ethnic minority (ref: Kinh/Hoa)"
 46.         if "`term'" == "1.ses5"     local nice "Q1 poorest (ref: Q5 richest)"
 47.         if "`term'" == "2.ses5"     local nice "Q2 (ref: Q5 richest)"
 48.         if "`term'" == "3.ses5"     local nice "Q3 (ref: Q5 richest)"
 49.         if "`term'" == "4.ses5"     local nice "Q4 (ref: Q5 richest)"
 50.         if "`term'" == "1.mme"      local nice "Mass media exposure (ref: no)"
 51.         if "`term'" == "1.ict"      local nice "ICT exposure (ref: no)"
 52.         if "`term'" == "1.dvindex"  local nice "Rejects all wife-beating justifications (ref: no)"
 53.         if "`term'" == "1.sb1n"     local nice "Ever had sexual intercourse (ref: no)"
 54.         scalar __est = exp(_b[`term'])
 55.         scalar __se  = _se[`term']
 56.         scalar __tcrit = invttail(`df', 0.025)
 57.         scalar __l = exp(_b[`term'] - __tcrit * __se)
 58.         scalar __u = exp(_b[`term'] + __tcrit * __se)
 59.         scalar __p = 2 * ttail(`df', abs(_b[`term'] / __se))
 60.         post `modout' ("`modelname'") ("`y'") ("`nice'") (`nobs') (__est) (__l) (__u) (__p)
 61.     }
 62. }

. postclose `modout'

. postclose `margout'

. 
. preserve

. use "`tab_dir'/table5_models.dta", clear

. format estimate lci uci %8.3f

. format pvalue %9.4f

. export delimited using "`tab_dir'/table5_models.csv", replace
