 10.             scalar __ci = r(CI)
 11.             scalar __se = r(CIse)
 12.             scalar __n  = r(N)
 13.             scalar __l  = __ci - invnormal(0.975) * __se
 14.             scalar __u  = __ci + invnormal(0.975) * __se
 15.             scalar __p  = 2 * normal(-abs(__ci / __se))
 16.             post `ciout' ("`y'") ("`kind'") (__n) (__ci) (__se) (__l) (__u) (__p)
 17.         }
 18.     }
 19. }
