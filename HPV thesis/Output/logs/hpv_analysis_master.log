. foreach y in ccp5_bin ccp6_bin gap {
  2.     foreach kind in standard erreygers {
  3.         if "`kind'" == "standard" {
  4.             capture noisily conindex `y', rankvar(ses) truezero limits(0 1) svy
  5.         }
  6.         else {
  7.             capture noisily conindex `y', rankvar(ses) bounded limits(0 1) erreygers svy
  8.         }
